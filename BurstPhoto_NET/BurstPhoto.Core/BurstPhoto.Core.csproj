<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="MetadataExtractor" Version="2.9.0" />
    <PackageReference Include="HurlbertVisionLab.LibRawWrapper" Version="1.0.2.3" />
    <!-- Keep Sdcb.LibRaw for potential fallback/metadata if needed -->
  </ItemGroup>

  <!-- Copy native DNG SDK wrapper DLL to output -->
  <ItemGroup>
    <Content Include="..\bin\Release\x64\BurstPhoto.Native.dll" Condition="Exists('..\bin\Release\x64\BurstPhoto.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BurstPhoto.Native.dll</Link>
    </Content>
  </ItemGroup>

</Project>
